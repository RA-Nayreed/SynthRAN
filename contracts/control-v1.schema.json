{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthran.invalid/contracts/control-v1.schema.json",
  "title": "SynthRAN control message v1",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["v", "id", "method"],
      "properties": {
        "v": {"const": 1},
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "method": {
          "enum": ["system.handshake", "workspace.snapshot"]
        },
        "params": {"type": "object", "maxProperties": 0}
      },
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "required": ["v", "id", "ok", "result"],
      "properties": {
        "v": {"const": 1},
        "id": {"type": "string"},
        "ok": {"const": true},
        "result": {"type": "object"}
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["v", "id", "ok", "error"],
      "properties": {
        "v": {"const": 1},
        "id": {"type": ["string", "null"]},
        "ok": {"const": false},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string"},
            "message": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
