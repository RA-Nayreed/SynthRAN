{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthran.invalid/contracts/live-preflight-v1alpha1.schema.json",
  "title": "SynthRAN live preflight evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at_utc",
    "ready",
    "inventory_sha256",
    "owner_fingerprint",
    "reservation_fingerprint",
    "allocation_fingerprint",
    "checks"
  ],
  "properties": {
    "schema": {"const": "synthran/live-preflight/v1alpha1"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "ready": {"type": "boolean"},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "owner_fingerprint": {"$ref": "#/$defs/sha256"},
    "reservation_fingerprint": {"$ref": "#/$defs/sha256"},
    "allocation_fingerprint": {"$ref": "#/$defs/sha256"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed", "detail"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}
