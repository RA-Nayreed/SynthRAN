{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthran.invalid/contracts/live-preflight-v1alpha2.schema.json",
  "title": "SynthRAN controller-bound live preflight evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at_utc",
    "ready",
    "dependency_lock_sha256",
    "slices_controller",
    "inventory_sha256",
    "owner_fingerprint",
    "reservation_fingerprint",
    "allocation_fingerprint",
    "checks"
  ],
  "properties": {
    "schema": {"const": "synthran/live-preflight/v1alpha2"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "ready": {"type": "boolean"},
    "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
    "slices_controller": {
      "anyOf": [
        {"$ref": "#/$defs/controller"},
        {"type": "null"}
      ]
    },
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "owner_fingerprint": {"$ref": "#/$defs/sha256"},
    "reservation_fingerprint": {"$ref": "#/$defs/sha256"},
    "allocation_fingerprint": {"$ref": "#/$defs/sha256"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ready",
        "dependency_lock_sha256",
        "project_fingerprint",
        "experiment_fingerprint",
        "python_version",
        "ansible_version",
        "pos_version",
        "slices_cli_version"
      ],
      "properties": {
        "schema": {"const": "synthran/slices-controller/v1alpha1"},
        "ready": {"const": true},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "project_fingerprint": {"$ref": "#/$defs/sha256"},
        "experiment_fingerprint": {"$ref": "#/$defs/sha256"},
        "python_version": {"type": "string", "minLength": 1},
        "ansible_version": {"type": "string", "minLength": 1},
        "pos_version": {"type": "string", "minLength": 1},
        "slices_cli_version": {"type": "string", "minLength": 1}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed", "detail"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}
