{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthran.invalid/contracts/resource-preparation-v1alpha1.schema.json",
  "title": "SynthRAN SLICES resource preparation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "status",
    "updated_at_utc",
    "inventory",
    "dependencies",
    "dependency_lock_sha256",
    "slices_controller",
    "overlays",
    "authority",
    "reservation_action",
    "allocation_action",
    "inventory_file",
    "authority_file",
    "preparation_log",
    "worktree"
  ],
  "properties": {
    "schema": {"const": "synthran/resource-preparation/v1alpha1"},
    "run_id": {"$ref": "#/$defs/run_id"},
    "status": {"enum": ["running", "failed", "prepared"]},
    "updated_at_utc": {"type": "string", "format": "date-time"},
    "inventory": {
      "type": "object",
      "required": ["file_name", "sha256", "core", "ran", "radio", "core_node", "ran_node"],
      "properties": {
        "file_name": {"const": "hosts.ini"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "core": {"const": "open5gs"},
        "ran": {"const": "srsRAN"},
        "radio": {"const": "rfsim"},
        "core_node": {"type": "string"},
        "ran_node": {"type": "string"},
        "co_located": {"const": false},
        "monitoring_enabled": {"const": false}
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fiveg_ansible"],
      "properties": {
        "fiveg_ansible": {"$ref": "#/$defs/commit"}
      }
    },
    "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
    "slices_controller": {"$ref": "#/$defs/controller"},
    "overlays": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ansible_overlay_sha256"],
      "properties": {
        "ansible_overlay_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_fingerprint",
        "reservation_fingerprint",
        "allocation_fingerprint"
      ],
      "properties": {
        "owner_fingerprint": {"$ref": "#/$defs/sha256"},
        "reservation_fingerprint": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "allocation_fingerprint": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "reservation_action": {"enum": ["create", "reuse"]},
    "allocation_action": {"enum": ["pending", "create", "reuse"]},
    "inventory_file": {"const": "hosts.ini"},
    "authority_file": {"const": "authority.env"},
    "preparation_log": {"const": "preparation.log"},
    "worktree": {"const": "worktree"},
    "failure_stage": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ready",
        "dependency_lock_sha256",
        "project_fingerprint",
        "experiment_fingerprint",
        "python_version",
        "ansible_version",
        "pos_version",
        "slices_cli_version"
      ],
      "properties": {
        "schema": {"const": "synthran/slices-controller/v1alpha1"},
        "ready": {"const": true},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "project_fingerprint": {"$ref": "#/$defs/sha256"},
        "experiment_fingerprint": {"$ref": "#/$defs/sha256"},
        "python_version": {"type": "string", "minLength": 1},
        "ansible_version": {"type": "string", "minLength": 1},
        "pos_version": {"type": "string", "minLength": 1},
        "slices_cli_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
