{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthran.invalid/contracts/network-deployment-v1alpha1.schema.json",
  "title": "SynthRAN network deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "status",
    "updated_at_utc",
    "inventory",
    "profile",
    "dependencies",
    "overlays",
    "authority",
    "reservation_action",
    "worktree",
    "deployment_log"
  ],
  "properties": {
    "schema": {"const": "synthran/network-deployment/v1alpha1"},
    "run_id": {"$ref": "#/$defs/run_id"},
    "status": {
      "enum": ["running", "failed", "deployed-unverified", "path-proven"]
    },
    "updated_at_utc": {"type": "string", "format": "date-time"},
    "inventory": {
      "type": "object",
      "required": ["file_name", "sha256", "core", "ran", "radio", "core_node", "ran_node"],
      "properties": {
        "file_name": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "core": {"const": "open5gs"},
        "ran": {"const": "srsRAN"},
        "radio": {"const": "rfsim"},
        "core_node": {"type": "string"},
        "ran_node": {"type": "string"},
        "co_located": {"const": false},
        "monitoring_enabled": {"const": false}
      },
      "additionalProperties": false
    },
    "profile": {"const": "default"},
    "dependencies": {"$ref": "#/$defs/dependencies"},
    "overlays": {
      "type": "object",
      "additionalProperties": false,
        "required": ["ansible_overlay_sha256"],
      "properties": {
          "ansible_overlay_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_fingerprint",
        "reservation_fingerprint",
        "allocation_fingerprint"
      ],
      "properties": {
        "owner_fingerprint": {"$ref": "#/$defs/sha256"},
        "reservation_fingerprint": {"$ref": "#/$defs/sha256"},
        "allocation_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "reservation_action": {"const": "none"},
    "worktree": {"const": "worktree"},
    "deployment_log": {"const": "deployment.log"},
    "failure_stage": {"type": "string", "minLength": 1},
    "network_evidence": {"const": "network-evidence.json"}
  },
  "$defs": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fiveg_ansible", "open5gs_k8s", "srsran_helm"],
      "properties": {
        "fiveg_ansible": {"$ref": "#/$defs/commit"},
        "open5gs_k8s": {"$ref": "#/$defs/commit"},
        "srsran_helm": {"$ref": "#/$defs/commit"}
      }
    }
  }
}
