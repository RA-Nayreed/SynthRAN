{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthran/telemetry/v1alpha1",
  "title": "SynthRAN deterministic telemetry event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "sensor_id", "sequence", "sensor_time_ms", "value_milli"],
  "properties": {
    "schema": {"const": "synthran/telemetry/v1alpha1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "sensor_id": {"type": "string", "pattern": "^sensor-(0[1-9]|10)$"},
    "sequence": {"type": "integer", "minimum": 1},
    "sensor_time_ms": {"type": "integer", "minimum": 0},
    "value_milli": {"type": "integer"}
  }
}
