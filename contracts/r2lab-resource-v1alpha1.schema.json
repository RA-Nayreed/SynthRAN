{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthran/r2lab-resource/v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "status",
    "updated_at_utc",
    "lease_action",
    "resources",
    "resource_claim",
    "password_storage",
    "global_power_off"
  ],
  "properties": {
    "schema": {"const": "synthran/r2lab-resource/v1alpha1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "status": {"enum": ["running", "ready", "failed", "release-failed", "released"]},
    "updated_at_utc": {"type": "string", "format": "date-time"},
    "lease_action": {"const": "reuse-active"},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway", "slice_fingerprint", "radio", "ue", "ue_kind", "ue_mode"],
      "properties": {
        "gateway": {"const": "faraday.inria.fr"},
        "slice_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "radio": {"enum": ["n300", "n320"]},
        "ue": {
          "enum": [
            "qhat01", "qhat02", "qhat03", "qhat10", "qhat11", "qhat20", "qhat21", "qhat22",
            "qfit07", "qfit09", "qfit18", "qfit29", "qfit32", "qfit34"
          ]
        },
        "ue_kind": {"enum": ["qhat", "qfit"]},
        "ue_mode": {"enum": ["mbim", "qmi"]}
      }
    },
    "resource_claim": {"enum": ["held", "released"]},
    "password_storage": {"const": false},
    "global_power_off": {"const": false},
    "failure_stage": {"type": "string", "minLength": 1}
  }
}
