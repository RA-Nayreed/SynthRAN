{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthran.invalid/contracts/control-v4.schema.json",
  "title": "SynthRAN control message v4",
  "oneOf": [
    {"$ref": "#/$defs/handshakeRequest"},
    {"$ref": "#/$defs/snapshotRequest"},
    {"$ref": "#/$defs/createExperimentRequest"},
    {"$ref": "#/$defs/providerExperimentsRequest"},
    {"$ref": "#/$defs/bindProviderRequest"},
    {"$ref": "#/$defs/resourceSnapshotRequest"},
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
    "emptyParams": {"type": "object", "maxProperties": 0},
    "handshakeRequest": {
      "type": "object",
      "required": ["v", "id", "method", "params"],
      "properties": {
        "v": {"const": 4},
        "id": {"$ref": "#/$defs/requestId"},
        "method": {"const": "system.handshake"},
        "params": {"$ref": "#/$defs/emptyParams"}
      },
      "additionalProperties": false
    },
    "snapshotRequest": {
      "type": "object",
      "required": ["v", "id", "method", "params"],
      "properties": {
        "v": {"const": 4},
        "id": {"$ref": "#/$defs/requestId"},
        "method": {"const": "workspace.snapshot"},
        "params": {"$ref": "#/$defs/emptyParams"}
      },
      "additionalProperties": false
    },
    "providerExperimentsRequest": {
      "type": "object",
      "required": ["v", "id", "method", "params"],
      "properties": {
        "v": {"const": 4},
        "id": {"$ref": "#/$defs/requestId"},
        "method": {"const": "provider.experiments"},
        "params": {"$ref": "#/$defs/emptyParams"}
      },
      "additionalProperties": false
    },
    "resourceSnapshotRequest": {
      "type": "object",
      "required": ["v", "id", "method", "params"],
      "properties": {
        "v": {"const": 4},
        "id": {"$ref": "#/$defs/requestId"},
        "method": {"const": "resources.snapshot"},
        "params": {"$ref": "#/$defs/emptyParams"}
      },
      "additionalProperties": false
    },
    "createExperimentRequest": {
      "type": "object",
      "required": ["v", "id", "method", "params"],
      "properties": {
        "v": {"const": 4},
        "id": {"$ref": "#/$defs/requestId"},
        "method": {"const": "experiment.create"},
        "params": {
          "type": "object",
          "required": ["intent", "radio_mode"],
          "properties": {
            "intent": {
              "enum": ["unspecified", "virtual-5g", "physical-5g", "open-ran", "iot-to-5g"]
            },
            "radio_mode": {"enum": ["automatic", "virtual", "physical"]},
            "label": {
              "anyOf": [
                {"type": "string", "minLength": 1, "maxLength": 120, "pattern": ".*\\S.*"},
                {"type": "null"}
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "bindProviderRequest": {
      "type": "object",
      "required": ["v", "id", "method", "params"],
      "properties": {
        "v": {"const": 4},
        "id": {"$ref": "#/$defs/requestId"},
        "method": {"const": "experiment.bind_provider"},
        "params": {
          "type": "object",
          "required": ["provider_experiment"],
          "properties": {
            "provider_experiment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "required": ["v", "id", "ok", "result"],
      "properties": {
        "v": {"const": 4},
        "id": {"type": "string"},
        "ok": {"const": true},
        "result": {"type": "object"}
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["v", "id", "ok", "error"],
      "properties": {
        "v": {"const": 4},
        "id": {"type": ["string", "null"]},
        "ok": {"const": false},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string"},
            "message": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
