{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthran.invalid/contracts/network-evidence-v1alpha1.schema.json",
  "title": "SynthRAN golden-path network evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "generated_at_utc",
    "inventory_sha256",
    "dependencies",
    "path",
    "checks",
    "ready"
  ],
  "properties": {
    "schema": {"const": "synthran/network-evidence/v1alpha1"},
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "dependencies": {"$ref": "#/$defs/dependencies"},
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core",
        "ran",
        "radio",
        "slice",
        "sst",
        "dnn",
        "ue_interface",
        "pdu_address",
        "pdu_network"
      ],
      "properties": {
        "core": {"const": "open5gs"},
        "ran": {"const": "srsRAN"},
        "radio": {"const": "rfsim"},
        "slice": {"const": "slice1"},
        "sst": {"const": 1},
        "dnn": {"const": "internet"},
        "ue_interface": {"const": "tun_srsue1"},
        "pdu_address": {
          "type": ["string", "null"],
          "format": "ipv4"
        },
        "pdu_network": {"const": "12.1.0.0/16"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "ready": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fiveg_ansible", "open5gs_k8s", "srsran_helm"],
      "properties": {
        "fiveg_ansible": {"$ref": "#/$defs/commit"},
        "open5gs_k8s": {"$ref": "#/$defs/commit"},
        "srsran_helm": {"$ref": "#/$defs/commit"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed", "detail"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}
