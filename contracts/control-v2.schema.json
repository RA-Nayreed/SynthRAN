{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthran.invalid/contracts/control-v2.schema.json",
  "title": "SynthRAN control message v2",
  "oneOf": [
    {"$ref": "#/$defs/handshakeRequest"},
    {"$ref": "#/$defs/snapshotRequest"},
    {"$ref": "#/$defs/createExperimentRequest"},
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "requestBase": {
      "type": "object",
      "required": ["v", "id", "method", "params"],
      "properties": {
        "v": {"const": 2},
        "id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "handshakeRequest": {
      "allOf": [
        {"$ref": "#/$defs/requestBase"},
        {
          "properties": {
            "method": {"const": "system.handshake"},
            "params": {"type": "object", "maxProperties": 0}
          },
          "required": ["method", "params"],
          "unevaluatedProperties": false
        }
      ]
    },
    "snapshotRequest": {
      "allOf": [
        {"$ref": "#/$defs/requestBase"},
        {
          "properties": {
            "method": {"const": "workspace.snapshot"},
            "params": {"type": "object", "maxProperties": 0}
          },
          "required": ["method", "params"],
          "unevaluatedProperties": false
        }
      ]
    },
    "createExperimentRequest": {
      "allOf": [
        {"$ref": "#/$defs/requestBase"},
        {
          "properties": {
            "method": {"const": "experiment.create"},
            "params": {
              "type": "object",
              "required": ["intent", "radio_mode"],
              "properties": {
                "intent": {
                  "enum": ["unspecified", "virtual-5g", "physical-5g", "open-ran", "iot-to-5g"]
                },
                "radio_mode": {"enum": ["automatic", "virtual", "physical"]}
              },
              "additionalProperties": false
            }
          },
          "required": ["method", "params"],
          "unevaluatedProperties": false
        }
      ]
    },
    "success": {
      "type": "object",
      "required": ["v", "id", "ok", "result"],
      "properties": {
        "v": {"const": 2},
        "id": {"type": "string"},
        "ok": {"const": true},
        "result": {"type": "object"}
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["v", "id", "ok", "error"],
      "properties": {
        "v": {"const": 2},
        "id": {"type": ["string", "null"]},
        "ok": {"const": false},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string"},
            "message": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
