{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthran.local/contracts/research-evidence-v1alpha1.schema.json",
  "title": "SynthRAN Research Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "campaign_id", "valid", "checks"],
  "properties": {
    "schema": {"const": "synthran/research-evidence/v1alpha1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 63},
    "campaign_id": {"type": "string", "minLength": 1, "maxLength": 63},
    "valid": {"type": "boolean"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"}
        }
      }
    }
  }
}
