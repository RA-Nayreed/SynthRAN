{
  "name": "@synthran/cli",
  "version": "0.0.0-development",
  "private": true,
  "description": "SynthRAN interactive terminal workbench",
  "type": "module",
  "bin": {
    "synthran": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/backend/*.test.js"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "typescript": "7.0.2"
  }
}
