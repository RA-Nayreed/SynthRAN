{
  "schema_version": 1,
  "experiment": "ex2-causal-5g-transport",
  "design_status": "frozen-before-transport-outcomes",
  "design_rationale": "Use all 30 frozen knee-common Experiment-1 source seeds as the independent blocks. Cross each source with four event-identical timing arms and three prespecified competing-load levels. This keeps 360 confirmation replays while giving the primary timing contrasts 30 independent source blocks.",
  "source_selection": {
    "experiment_1_campaign_id": "20260913T185453409916Z",
    "experiment_1_design_version": 2,
    "experiment_1_source_revision": "4f8cc5d3f71a14537367c24d6030ffb3bf355ea4",
    "condition": "knee-common",
    "seed_policy": "all_frozen_confirmation_seeds",
    "expected_seed_count": 30,
    "require_completed_phases": [
      "confirmation",
      "analysis"
    ]
  },
  "timing_interventions": {
    "arms": [
      "native",
      "gap_permutation_r1",
      "gap_permutation_r2",
      "periodic"
    ],
    "warmup_seconds": 10.0,
    "permutation_seed_rule": "sha256(campaign_id|condition|source_seed|arm), first 8 bytes",
    "invariants": [
      "event IDs and order",
      "event count",
      "sensor identity",
      "serialized payload bytes and hashes",
      "MQTT topic",
      "transport gateway assignment within a transport profile",
      "source horizon",
      "measurement first and last release for transformed measurement events"
    ],
    "generation_age_valid": {
      "native": true,
      "gap_permutation_r1": false,
      "gap_permutation_r2": false,
      "periodic": false
    }
  },
  "transport_profiles": {
    "r2lab": {
      "role": "primary_physical_confirmation",
      "core": "oai",
      "ran": "srsran",
      "platform": "r2lab",
      "ru": "n320",
      "nodes": {
        "core": "sopnode-f2",
        "ran": "sopnode-f3",
        "broker": "sopnode-f2"
      },
      "network_profile": "default",
      "workload_gateway": "qhat01",
      "competing_traffic_ue": "qhat03",
      "ue_slices": {
        "qhat01": "slice1",
        "qhat03": "slice1"
      },
      "host_vars": {
        "sopnode-f3": {
          "cpu_low_latency": true
        }
      }
    },
    "rfsim": {
      "role": "software_qualification_control",
      "core": "oai",
      "ran": "srsran",
      "platform": "rfsim",
      "nodes": {
        "core": "sopnode-f2",
        "ran": "sopnode-f3",
        "broker": "sopnode-f2"
      },
      "network_profile": "default",
      "workload_gateway": "uesim01",
      "competing_traffic_ue": "uesim03",
      "ue_slices": {
        "uesim01": "slice1",
        "uesim03": "slice1"
      },
      "host_vars": {
        "sopnode-f3": {
          "cpu_low_latency": true
        }
      }
    }
  },
  "qualification": {
    "source_seed_policy": "first frozen source seed",
    "timing_arm": "native",
    "require_zero_transport_loss": true
  },
  "transport_calibration": {
    "generator": "paced UDP application payload",
    "packet_bytes": 1200,
    "probe_duration_seconds": 10,
    "repeats_per_rate": 3,
    "offered_payload_mbps_grid": [
      5,
      10,
      15,
      20,
      25,
      30,
      40,
      50
    ],
    "delivery_threshold": 0.98,
    "selection_rule": "Using median end-to-end delivery ratio over repeats at each ascending grid rate, define ABOVE as the first rate below threshold, NEAR as the immediately preceding rate, and BELOW as the rate immediately preceding NEAR. Stop without confirmation if all three levels cannot be selected.",
    "manual_rate_selection_forbidden": true,
    "base_port": 39001
  },
  "confirmation": {
    "source_seed_count": 30,
    "timing_arms": [
      "native",
      "gap_permutation_r1",
      "gap_permutation_r2",
      "periodic"
    ],
    "load_levels": [
      "below",
      "near",
      "above"
    ],
    "expected_replays": 360,
    "sessions": 3,
    "seeds_per_session": 10,
    "session_assignment": "ascending frozen source seeds split into three blocks of ten",
    "within_block_order_seed": 20260913,
    "sentinel_every_replays": 12,
    "sentinel_rate_level": "near",
    "base_port": 39101,
    "sentinel_min_fraction_of_calibrated_near_delivery": 0.98,
    "sentinel_base_port": 39901
  },
  "analysis": {
    "experimental_unit": "source_seed",
    "principal_outcomes": [
      "conditional_scheduled_delay_p95_s",
      "deadline_failure_fraction"
    ],
    "principal_contrasts": {
      "native_minus_periodic": "native - periodic",
      "native_minus_gap_controls": "native - mean(gap_permutation_r1, gap_permutation_r2)"
    },
    "load_interaction": "report each principal contrast separately at below, near, and above load",
    "permutation_arms_do_not_increase_n": true,
    "bootstrap_resamples": 10000,
    "bootstrap_seed": 62002,
    "multiplicity_note": "principal confidence intervals are paired by source seed; p-values, if later added, require planned-family correction"
  },
  "measurement": {
    "deadline_seconds": 0.5,
    "age_limit_seconds": 2.0
  }
